# Credentials for the FREE web database (Aiven free MySQL, current MySQL 8).
# Copy this file to ".web-db.env" in the SAME folder and fill in your real
# values. .web-db.env is git-ignored, so your password never reaches the repo.

DB_HOST=mysql-XXXXXXXX-projectname.g.aivencloud.com
DB_PORT=33060
DB_USER=avnadmin
DB_PASSWORD=YourPasswordHere
DB_NAME=hostel_management

# Aiven requires TLS. The CA certificate is public and committed to the repo
# (certs\aiven-ca.pem); the path is resolved relative to the repo root.
# Leave blank for hosts that don't need TLS.
DB_SSL_CA=certs/aiven-ca.pem

# Aiven lets avnadmin create databases, but this project imports into a
# specific database, so strip the "CREATE DATABASE" and "USE hostel_management"
# lines before importing (web_db.py creates the database itself).
# Only set DB_STRIP_USING=0 if the host lets you create/rename the database
# so the files can import unchanged.
DB_STRIP_USING=1

# Local XAMPP MySQL used by sync_web_db.bat (push = local -> web, pull = web -> local)
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=hostel_management

# Optional overrides for the local-side tools used by push/pull.
# MYSQL_EXE=C:\xampp\mysql\bin\mysql.exe
# MYSQLDUMP_EXE=C:\xampp\mysql\bin\mysqldump.exe
